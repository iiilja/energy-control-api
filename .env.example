# Energy Control API - Environment Variables
# Copy this file to .env and customize as needed

# Spring Profile (dev, prod)
SPRING_PROFILE=dev

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=energy_control
DB_USERNAME=energy_user
DB_PASSWORD=energy_pass

# Application Configuration
SERVER_PORT=8080
COLLECTION_INTERVAL_MS=60000

# Admin User (will be created by migration)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# OAuth2 Configuration (future use)
ISSUER_URI=http://localhost:8080
