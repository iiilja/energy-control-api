# Banana Pi (ARMv7) Dockerfile — uses Jammy (Ubuntu 22.04) base images
# which have linux/arm/v7 support, unlike Alpine-based images.
#
# Build stage runs on the host's native platform (x86_64 on GitHub Actions)
# so Gradle never runs under QEMU emulation. The JAR is pure Java bytecode
# and runs on arm/v7 without any changes.

# ===========================================================================
# Build Stage — native platform (no QEMU)
# ===========================================================================
FROM --platform=$BUILDPLATFORM eclipse-temurin:17-jdk-jammy AS build

ENV GRADLE_VERSION=8.5

RUN apt-get update && apt-get install -y --no-install-recommends wget unzip && \
    wget -q https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -P /tmp && \
    unzip -q /tmp/gradle-${GRADLE_VERSION}-bin.zip -d /opt && \
    rm /tmp/gradle-${GRADLE_VERSION}-bin.zip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/gradle-${GRADLE_VERSION}/bin:${PATH}"

WORKDIR /app

COPY gradle/ gradle/
COPY build.gradle .
COPY settings.gradle .
COPY src/ src/

RUN gradle build -x test --no-daemon

# ===========================================================================
# Runtime Stage
# ===========================================================================
FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

RUN groupadd -r spring && useradd -r -g spring spring

RUN mkdir -p /app/logs && chown spring:spring /app/logs

# --chown in COPY: a separate `RUN chown` would duplicate the whole jar in a new layer
COPY --from=build --chown=spring:spring /app/build/libs/*.jar app.jar

USER spring:spring

EXPOSE 8080

# Reduced heap for 1 GB device — leaves room for PostgreSQL and OS
ENV JAVA_OPTS="-Xms128m -Xmx384m"

# Shell form so JAVA_OPTS is expanded; exec keeps java as PID 1 to receive SIGTERM (graceful shutdown).
# "$@" passes `docker run <image> <args>` through to the app.
# JAVA_OPTS is split on spaces without quote handling: use it for plain flags (-Xmx512m),
# put quoted values (-Dfoo="a b") into JAVA_TOOL_OPTIONS instead.
# JAVA_OPTS is on the command line, so its -Xmx wins over -Xmx from JAVA_TOOL_OPTIONS.
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar \"$@\"", "--"]
