# ARM64 Dockerfile — H96 Pro+ (Amlogic S912) and other arm64 boards.
#
# Build stage runs on the host's native platform (x86_64 on GitHub Actions)
# so Gradle never runs under QEMU emulation. The JAR is pure Java bytecode
# and runs on arm64 without any changes.
#
# Runtime uses eclipse-temurin's jammy (Ubuntu) base, not alpine — the
# *-alpine tags are amd64-only (no arm64 manifest published).

# ===========================================================================
# Build Stage — native platform (no QEMU)
# ===========================================================================
FROM --platform=$BUILDPLATFORM gradle:8.5-jdk17-alpine AS build

WORKDIR /app

COPY gradle/ gradle/
COPY build.gradle .
COPY settings.gradle .
COPY src/ src/

RUN gradle build -x test --no-daemon

# ===========================================================================
# Runtime Stage
# ===========================================================================
FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends wget && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd -r spring && useradd -r -g spring spring

RUN mkdir -p /app/logs && chown spring:spring /app/logs

COPY --from=build /app/build/libs/*.jar app.jar

RUN chown spring:spring app.jar

USER spring:spring

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]

ENV JAVA_OPTS="-Xms256m -Xmx512m"
